  ; Copy all files
  File "docker-compose.yml"
  File ".env"
  File "launch.bat"
  File "stop.bat"
  File "README.txt"
  
  ; Create data directories in APPDATA
  CreateDirectory "$APPDATA\Adesso\DocumentAnalyzer"
  CreateDirectory "$APPDATA\Adesso\DocumentAnalyzer\postgres"
  CreateDirectory "$APPDATA\Adesso\DocumentAnalyzer\chroma"
  CreateDirectory "$APPDATA\Adesso\DocumentAnalyzer\ollama"
  
