<file path="installer/staging/docker-compose.yml">
version: '3.8'

services:
  backend:
    image: enterprise-doc-analyzer-backend:latest
    container_name: doc-analyzer-backend
    environment:
      OPENAI_API_KEY: ${OPENAI_API_KEY:-sk-test-key}
      CHROMA_URL: http://chroma:8000
      OLLAMA_BASE_URL: http://ollama:11434
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/docdb
      SPRING_DATASOURCE_USERNAME: docuser
      SPRING_DATASOURCE_PASSWORD: ${DB_PASSWORD:-docpass123}
      APP_EMBEDDING_MODEL: mxbai-embed-large
      APP_CHUNKING_CHUNK_SIZE: 1024
      APP_CHUNKING_OVERLAP: 100
      APP_CHUNKING_MIN_CHUNK_SIZE: 256
    depends_on:
      postgres:
        condition: service_healthy
      chroma:
        condition: service_started
      ollama:
        condition: service_started
      ollama-init:
        condition: service_completed_successfully
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - docnet
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:8080/api/chat/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    ports:
      - "8080:8080"

  postgres:
    image: postgres:16-alpine
    container_name: doc-analyzer-db
    environment:
      POSTGRES_DB: docdb
      POSTGRES_USER: docuser
      POSTGRES_PASSWORD: ${DB_PASSWORD:-docpass123}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - docnet
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U docuser -d docdb"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s

  chroma:
    image: ghcr.io/chroma-core/chroma:latest
    container_name: doc-analyzer-vector-db
    environment:
      CHROMA_DB_IMPL: duckdb+parquet
      PERSIST_DIRECTORY: /chroma/data
    volumes:
      - chroma_data:/chroma/data
    networks:
      - docnet
    ports:
      - "8002:8000"

  ollama:
    image: ollama/ollama:latest
    container_name: doc-analyzer-ollama
    ports:
      - "11434:11434"
    environment:
      OLLAMA_HOST: 0.0.0.0:11434
    volumes:
      - ollama_data:/root/.ollama
    networks:
      - docnet

  ollama-init:
    image: ollama/ollama:latest
    container_name: doc-analyzer-ollama-init
    depends_on:
      ollama:
        condition: service_started
    environment:
      OLLAMA_HOST: http://ollama:11434
    networks:
      - docnet
    entrypoint: /bin/sh
    command: -c "ollama pull qwen2.5:0.5b && ollama pull mxbai-embed-large && echo 'Models loaded successfully'"
    restart: "no"

  frontend:
    image: enterprise-doc-analyzer-frontend:latest
    container_name: doc-analyzer-frontend
    environment:
      REACT_APP_API_URL: http://localhost:8080/api
    networks:
      - docnet
    ports:
      - "3000:3000"
    depends_on:
      - backend

volumes:
  postgres_data:
  chroma_data:
  ollama_data:

networks:
  docnet:
    driver: bridge
</file>

<file path="installer/staging/docker-start.bat">
@echo off
REM Docker daemon starter for standalone installation
REM This script detects and starts Docker in the most compatible way

setlocal enabledelayedexpansion

set "APP_DIR=%~dp0"
set "LOG_FILE=%APP_DIR%docker-start.log"

echo Starting Docker daemon...
echo %date% %time% - Starting Docker >> "%LOG_FILE%"

REM Try method 1: Docker Desktop service
sc query Docker >nul 2>&1
if errorlevel 0 (
    echo Checking Docker Desktop service...
    net start Docker >> "%LOG_FILE%" 2>&1
    if errorlevel 0 (
        echo Docker service started
        goto :DOCKER_READY
    )
)

REM Try method 2: Docker Desktop executable
if exist "%ProgramFiles%\Docker\Docker\Docker Desktop.exe" (
    echo Starting Docker Desktop...
    start "" "%ProgramFiles%\Docker\Docker\Docker Desktop.exe"
    timeout /t 15
    goto :DOCKER_READY
)

if exist "%LOCALAPPDATA%\Docker\Docker\Docker.exe" (
    echo Starting Docker...
    start "" "%LOCALAPPDATA%\Docker\Docker\Docker.exe"
    timeout /t 15
    goto :DOCKER_READY
)

REM Try method 3: Docker daemon directly
for /f "delims=" %%i in ('where docker 2^>nul') do (
    set "DOCKER_PATH=%%i"
)

if defined DOCKER_PATH (
    echo Found Docker at: %DOCKER_PATH%
    REM Docker is accessible
    goto :DOCKER_READY
)

echo WARNING: Docker could not be auto-started
echo Please start Docker Desktop manually
echo.
pause
exit /b 1

:DOCKER_READY
echo Docker daemon is ready
exit /b 0
</file>

<file path="installer/staging/init-docker.bat">
@echo off
REM Initialize Docker Engine for standalone installer

setlocal enabledelayedexpansion

set "APP_DIR=%~dp0"
set "DOCKER_HOME=%APP_DIR%docker-engine"
set "LOG_FILE=%APP_DIR%init-docker.log"

echo. > "%LOG_FILE%"
echo ============================================ >> "%LOG_FILE%"
echo Docker Engine Initialization - %date% %time% >> "%LOG_FILE%"
echo ============================================ >> "%LOG_FILE%"
echo. >> "%LOG_FILE%"

echo.
echo ============================================
echo Docker Engine Setup
echo ============================================
echo.

REM Check if Docker is already installed on system
docker version >nul 2>&1
if errorlevel 0 (
    echo Docker found on system
    echo Using system Docker installation
    goto :DOCKER_READY
)

echo Docker not found in PATH
echo.

REM Check for portable Docker in installation directory
if exist "%DOCKER_HOME%\docker.exe" (
    echo Found portable Docker in: %DOCKER_HOME%
    set "PATH=%DOCKER_HOME%;!PATH!"
    echo Added to PATH: %DOCKER_HOME%
    goto :DOCKER_READY
)

echo.
echo ERROR: Docker not found
echo.
echo Please install Docker from: https://www.docker.com/products/docker-desktop
echo OR ensure portable Docker is in: %DOCKER_HOME%
echo.
pause
exit /b 1

:DOCKER_READY
echo.
echo Verifying Docker daemon...
docker ps >nul 2>&1

if errorlevel 1 (
    echo ERROR: Docker daemon is not responding
    echo.
    echo Trying to start Docker daemon...
    
    REM Try to start Docker
    if exist "%DOCKER_HOME%\dockerd.exe" (
        start "" "%DOCKER_HOME%\dockerd.exe" --log-level=info
        echo Waiting for Docker daemon to start...
        timeout /t 5
    ) else (
        echo ERROR: Docker daemon not found
        echo Please start Docker Desktop manually
        echo.
        pause
        exit /b 1
    )
)

echo Docker daemon is ready.
echo.
echo Docker Initialization Complete!
echo.
</file>

<file path="installer/staging/launch.bat">
@echo off
REM Standalone Launcher for Adesso Document Analyzer
REM Handles Docker startup, image loading, and service initialization
REM Docker Desktop MUST be pre-installed on system

setlocal enabledelayedexpansion

set "APP_DIR=%~dp0"
set "LOG_FILE=%APP_DIR%launch.log"

echo. > "%LOG_FILE%"
echo ============================================ >> "%LOG_FILE%"
echo Launch %date% %time% >> "%LOG_FILE%"
echo ============================================ >> "%LOG_FILE%"

echo.
echo ============================================
echo Adesso Document Analyzer
echo ============================================
echo.

REM Check if docker-images folder exists in installation
if not exist "%APP_DIR%docker-images" (
    echo ERROR: docker-images folder not found in installation directory
    echo.
    echo Expected: %APP_DIR%docker-images\
    echo.
    echo This installation may be incomplete.
    echo Please reinstall the application.
    echo.
    pause
    exit /b 1
)

REM Ensure Docker is running
echo Checking Docker daemon...

REM Start Docker if needed
call "%APP_DIR%docker-start.bat"
if errorlevel 1 (
    echo.
    echo ERROR: Docker could not be started
    echo.
    echo IMPORTANT: This application requires Docker to be installed.
    echo.
    echo Docker Desktop is available at: https://www.docker.com/products/docker-desktop
    echo.
    echo After installing Docker Desktop:
    echo   1. Start Docker Desktop application
    echo   2. Run this application again
    echo.
    pause
    exit /b 1
)

REM Verify Docker is responding
docker ps >nul 2>&1
if errorlevel 1 (
    echo ERROR: Docker daemon not responding
    echo Please wait a moment and try again
    pause
    exit /b 1
)

echo Docker is ready

REM Check if images need to be loaded
echo.
echo Checking Docker images...
docker images | find "enterprise-doc-analyzer-backend" >nul 2>&1
if errorlevel 1 (
    echo.
    echo Loading Docker images...
    echo This may take 3-5 minutes on first run...
    echo.
    call "%APP_DIR%load-images.bat" >> "%LOG_FILE%" 2>&1
    if errorlevel 1 (
        echo ERROR: Failed to load Docker images
        echo Check: %LOG_FILE%
        pause
        exit /b 1
    )
    echo Images loaded successfully
)

REM Start services
echo.
echo Starting services...
cd /d "%APP_DIR%"
docker compose up -d >> "%LOG_FILE%" 2>&1

if errorlevel 1 (
    echo ERROR: Failed to start services
    echo.
    echo Try these solutions:
    echo 1. Ensure Docker Desktop is running
    echo 2. Check: docker compose logs
    echo 3. Check: %LOG_FILE%
    echo.
    pause
    exit /b 1
)

echo Services started

REM Wait for services to become healthy
echo.
echo Waiting for services to be ready...
set "WAIT_COUNT=0"
:WAIT_LOOP
docker compose ps 2>nul | find "healthy\|running" >nul
if errorlevel 1 (
    if !WAIT_COUNT! LSS 60 (
        set /a WAIT_COUNT+=1
        timeout /t 1 /nobreak
        goto :WAIT_LOOP
    )
)

echo.
echo ============================================
echo Ready!
echo ============================================
echo.
echo Application: http://localhost:3000
echo API: http://localhost:8080/api
echo.
echo Opening browser...
timeout /t 2

start http://localhost:3000

echo.
echo If browser doesn't open, visit: http://localhost:3000
echo.
</file>

<file path="installer/staging/load-images.bat">
@echo off
REM Load Docker images from standalone installer package

setlocal enabledelayedexpansion

set "APP_DIR=%~dp0"
set "IMAGES_DIR=%APP_DIR%docker-images"
set "LOG_FILE=%APP_DIR%load-images.log"

echo. > "%LOG_FILE%"
echo ============================================ >> "%LOG_FILE%"
echo Docker Image Loader - %date% %time% >> "%LOG_FILE%"
echo ============================================ >> "%LOG_FILE%"
echo. >> "%LOG_FILE%"

echo.
echo ============================================
echo Loading Docker Images
echo ============================================
echo.

REM Check if images directory exists
if not exist "%IMAGES_DIR%" (
    echo ERROR: Docker images directory not found
    echo Expected: %IMAGES_DIR%
    pause
    exit /b 1
)

echo Found images directory: %IMAGES_DIR%
echo.

REM Check Docker daemon
echo Checking Docker daemon...
docker ps >nul 2>&1
if errorlevel 1 (
    echo ERROR: Docker is not running
    echo Please start Docker Desktop or Docker Engine
    pause
    exit /b 1
)
echo Docker daemon is running.
echo.

REM Count and load images
set "LOADED=0"
set "FAILED=0"

echo Loading images...
echo.

for %%F in ("%IMAGES_DIR%\*.tar") do (
    set "FILENAME=%%~nxF"
    echo Loading: !FILENAME!
    
    docker load -i "%%F" >> "%LOG_FILE%" 2>&1
    
    if errorlevel 1 (
        echo ERROR: Failed to load !FILENAME!
        echo ERROR: Failed to load !FILENAME! >> "%LOG_FILE%"
        set /a FAILED+=1
    ) else (
        echo Successfully loaded: !FILENAME!
        echo Successfully loaded: !FILENAME! >> "%LOG_FILE%"
        set /a LOADED+=1
    )
    echo.
)

echo ============================================
echo Image Loading Complete
echo ============================================
echo.
echo Successfully loaded: %LOADED% image(s)
if %FAILED% GTR 0 (
    echo Failed: %FAILED% image(s)
)
echo.
echo Log saved to: %LOG_FILE%
echo.

if %FAILED% GTR 0 (
    pause
    exit /b 1
)

pause
</file>

<file path="installer/staging/README.txt">
ADESSO DOCUMENT ANALYZER - STANDALONE INSTALLER
v1.0.0

========================================
SYSTEM REQUIREMENTS
========================================

REQUIRED:
- Windows 10/11 64-bit
- Docker Desktop installed (https://www.docker.com/products/docker-desktop)
- 8GB RAM minimum (16GB recommended)
- 30GB free disk space
- Internet connection (for first-run setup)

========================================
INSTALLATION
========================================

1. Download and run: Adesso-Document-Analyzer-Setup-1.0.0.exe
2. Follow the installation wizard
3. Choose installation directory (default: C:\Program Files\Adesso\DocumentAnalyzer)
4. Installer will download Docker images (10-30 minutes)
5. Installation complete!

========================================
FIRST RUN
========================================

1. Double-click desktop shortcut: "Adesso Document Analyzer"
   OR search for it in Start Menu
   
2. First launch will:
   - Start Docker daemon check
   - Verify Docker images are available
   - Launch all services (PostgreSQL, Chroma, Ollama, Backend, Frontend)
   - Open browser to http://localhost:3000
   
3. Wait 30-60 seconds for all services to become healthy

4. Application will load automatically

========================================
ACCESSING THE APPLICATION
========================================

Frontend UI:      http://localhost:3000
Backend API:      http://localhost:8080/api
Vector Database:  http://localhost:8002
LLM Engine:       http://localhost:11434

========================================
DATA STORAGE
========================================

All application data is stored locally in:
- Windows: %APPDATA%\Adesso\DocumentAnalyzer

Data includes:
- Documents you upload
- PostgreSQL database
- Vector embeddings (Chroma)
- LLM models (Ollama)

NO data is sent to cloud. 100% local storage.

========================================
STOPPING THE APPLICATION
========================================

Option 1: Run stop.bat from installation directory
Option 2: Use Docker Desktop to stop containers
Option 3: Close the application window (services continue running)

Data is preserved. Run launch.bat to restart.

========================================
UNINSTALLING
========================================

1. Open Control Panel > Programs > Programs and Features
2. Find "Adesso Document Analyzer"
3. Click Uninstall
4. Follow the uninstall wizard

All data in the application folder will be removed.
To preserve data, backup %APPDATA%\Adesso\DocumentAnalyzer before uninstalling.

========================================
TROUBLESHOOTING
========================================

ERROR: Docker is not installed
- Install Docker Desktop from https://www.docker.com/products/docker-desktop
- Restart the installer

ERROR: Docker daemon is not running
- Start Docker Desktop
- Wait for it to fully start
- Try launching the application again

ERROR: Services won't start
- Check Docker Desktop logs
- Ensure sufficient disk space
- Try: docker compose restart

ERROR: Can't access http://localhost:3000
- Wait 60 seconds for services to become ready
- Check Docker Desktop is running
- Try: docker compose logs frontend

Performance Issues
- Close other applications
- Allocate more RAM to Docker Desktop
- Ensure SSD storage for better performance

========================================
FEATURES
========================================

✓ Enterprise document analysis
✓ Vector-based semantic search
✓ CV to requirement matching
✓ Multi-document chat
✓ AI-powered insights
✓ 100% local - no cloud dependency
✓ No external API calls
✓ Fully containerized
✓ One-click installation

========================================
SUPPORT
========================================

For issues or questions, contact:
support@adesso.com

Visit documentation:
https://docs.adesso.com

========================================
VERSION INFORMATION
========================================

