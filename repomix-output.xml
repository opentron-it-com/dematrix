<file path="installer/launch.bat">
@echo off
REM Standalone Launcher for Adesso Document Analyzer
REM Handles Docker startup, image loading, and service initialization
REM Docker engine and images are downloaded on first run from SharePoint

setlocal enabledelayedexpansion

set "APP_DIR=%~dp0"
set "LOG_FILE=%APP_DIR%launch.log"

echo. > "%LOG_FILE%"
echo ============================================ >> "%LOG_FILE%"
echo Launch %date% %time% >> "%LOG_FILE%"
echo ============================================ >> "%LOG_FILE%"

echo.
echo ============================================
echo Adesso Document Analyzer
echo ============================================
echo.

REM Ensure required payload folders exist before auto-download
if not exist "%APP_DIR%docker-images" mkdir "%APP_DIR%docker-images"
if not exist "%APP_DIR%docker-engine" mkdir "%APP_DIR%docker-engine"

REM Ensure required payloads are present
set "DOWNLOAD_SCRIPT=%APP_DIR%download-from-sharepoint.ps1"
set "MANIFEST_FILE=%APP_DIR%sharepoint-manifest.json"
set "MISSING_ASSETS=0"
if not exist "%APP_DIR%docker-images\ollama-ollama-latest.tar" set "MISSING_ASSETS=1"
if not exist "%APP_DIR%docker-engine\dockerd.exe" set "MISSING_ASSETS=1"
if "%MISSING_ASSETS%" == "1" (
    echo Docker engine or model payloads are missing.
    if exist "%DOWNLOAD_SCRIPT%" (
        set "TARGET_DIR=!APP_DIR!"
        echo DEBUG: TARGET_DIR=!TARGET_DIR!
        powershell -NoProfile -ExecutionPolicy Bypass -File "%DOWNLOAD_SCRIPT%" -Manifest "%MANIFEST_FILE%" -TargetDir "!TARGET_DIR!"
        if errorlevel 1 (
            echo.
            echo ERROR: Failed to download required payloads.
            echo Please verify SharePoint access and retry.
            pause
            exit /b 1
        )
    ) else (
        echo ERROR: Download helper missing: %DOWNLOAD_SCRIPT%
        pause
        exit /b 1
    )
)

REM Ensure Docker is running
echo Checking Docker daemon...

REM Clear any stale Docker host info first
set "DOCKER_HOST="
set "DOCKER_ARGS="
set "DOCKER_CLI="
REM Start Docker if needed
call "%APP_DIR%docker-start.bat"
if exist "%APP_DIR%docker-env.cmd" call "%APP_DIR%docker-env.cmd"
if defined DOCKER_CLI echo After docker-start: DOCKER_CLI=%DOCKER_CLI%
if defined DOCKER_HOST echo After docker-start: DOCKER_HOST=%DOCKER_HOST%
if defined DOCKER_ARGS echo After docker-start: DOCKER_ARGS=%DOCKER_ARGS%
if errorlevel 1 (
    echo.
    echo ERROR: Docker could not be started
    echo.
    echo This installation downloads the Docker engine on first run.
    echo If the launcher cannot start Docker, please contact your administrator or support team.
    pause
    exit /b 1
)

REM Verify Docker is responding
if defined DOCKER_CLI echo Using Docker CLI: %DOCKER_CLI%
if defined DOCKER_HOST (
    echo Using Docker host: %DOCKER_HOST%
) else (
    echo Docker host not set; using default pipe
)
set /a WAIT_COUNT=0
:DOCKER_WAIT_LOOP
if not defined DOCKER_CLI set "DOCKER_CLI=docker"
if defined DOCKER_HOST (
    "%DOCKER_CLI%" --host "%DOCKER_HOST%" ps >nul 2>&1
) else (
    "%DOCKER_CLI%" ps >nul 2>&1
)
if errorlevel 0 (
    echo Docker is ready
) else (
    if %WAIT_COUNT% GEQ 15 (
        echo ERROR: Docker daemon not responding
        echo Please wait a moment and try again
        pause
        exit /b 1
    )
    set /a WAIT_COUNT+=1
    timeout /t 2 /nobreak >nul
    goto :DOCKER_WAIT_LOOP
)

REM Check if images need to be loaded
echo.
echo Checking Docker images...
if defined DOCKER_HOST (
    "%DOCKER_CLI%" --host "%DOCKER_HOST%" images | find "enterprise-doc-analyzer-backend" >nul 2>&1
) else (
    "%DOCKER_CLI%" images | find "enterprise-doc-analyzer-backend" >nul 2>&1
)
if errorlevel 1 (
    echo.
    echo Loading Docker images...
    echo This may take 3-5 minutes on first run...
    echo Docker image load progress will be shown below.
    echo See detailed logs in: %APP_DIR%load-images.log
    echo.
    call "%APP_DIR%load-images.bat"
    if errorlevel 1 (
        echo ERROR: Failed to load Docker images
        echo Check: %APP_DIR%load-images.log
        pause
        exit /b 1
    )
    echo Images loaded successfully
)

echo.
echo Starting services...
cd /d "%APP_DIR%"
if defined DOCKER_HOST (
    "%DOCKER_CLI%" --host "%DOCKER_HOST%" compose up -d >> "%LOG_FILE%" 2>&1
) else (
    "%DOCKER_CLI%" compose up -d >> "%LOG_FILE%" 2>&1
)

if errorlevel 1 (
    echo ERROR: Failed to start services
    echo.
    echo Try these solutions:
    echo 1. Ensure Docker Desktop is running
    echo 2. Check: docker compose logs
    echo 3. Check: %LOG_FILE%
    echo.
    pause
    exit /b 1
)

echo Services started

REM Wait for services to become healthy
echo.
echo Waiting for services to be ready...
set "WAIT_COUNT=0"
:WAIT_LOOP
if defined DOCKER_HOST (
    "%DOCKER_CLI%" --host "%DOCKER_HOST%" compose ps 2>nul | find "healthy\|running" >nul
) else (
    "%DOCKER_CLI%" compose ps 2>nul | find "healthy\|running" >nul
)
if errorlevel 1 (
    if !WAIT_COUNT! LSS 60 (
        set /a WAIT_COUNT+=1
        timeout /t 1 /nobreak
        goto :WAIT_LOOP
    )
)

echo.
echo ============================================
echo Ready!
echo ============================================
echo.
echo Application: http://localhost:3000
echo API: http://localhost:8080/api
echo.
echo Opening browser...
timeout /t 2

start http://localhost:3000

echo.
echo If browser doesn't open, visit: http://localhost:3000
echo.
</file>

